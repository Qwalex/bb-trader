# SignalsBot baseline environment example.
# Copy to `.env` (repo root) and/or `apps/api/.env`, then fill real secrets.

# --- Core API ---
NODE_ENV=development
# Роль процесса Nest API: all (локально) | api | worker-userbot | worker-bybit
# API_PROCESS_ROLE=all
# Межсервисный токен (одинаковый на Api + Worker-UB + Worker-Bybit в split-окружении)
# WORKER_INTERNAL_TOKEN=
# Private HTTP между Railway-сервисами (схема B, окружение cabinets):
# WORKER_BYBIT_INTERNAL_URL=http://worker-bybit.railway.internal:8080
# WORKER_UB_INTERNAL_URL=http://worker-ub.railway.internal:8080
# API_INTERNAL_URL=http://api.railway.internal:8080
# На Api: TELEGRAM_USERBOT_SKIP_STARTUP_RESTORE=true, WORKER_QUEUE_ENABLED=false
# На Worker-UB: WORKER_QUEUE_ENABLED=false
# На Worker-Bybit: WORKER_QUEUE_ENABLED=true (или не задавать — по умолчанию включено для role)
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
API_SWAGGER_SERVER=/
API_ACCESS_TOKEN=change-me-very-strong-token
AUTH_JWT_SECRET=change-me-even-stronger-secret
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_ALLOW_PUBLIC_REGISTER=false
AUTH_ADMIN_USER_IDS=

# --- Database ---
DATABASE_URL=postgresql://signals:signals@localhost:5432/signals?schema=public
POSTGRES_USER=signals
POSTGRES_PASSWORD=signals
POSTGRES_DB=signals

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_BASE_PATH=
NEXT_BASE_PATH=
# Календарные сутки (API) и отображение времени (Web). IANA, по умолчанию Europe/Moscow.
APP_TIMEZONE=Europe/Moscow
NEXT_PUBLIC_DISPLAY_TIMEZONE=Europe/Moscow
WEB_APP_ORIGIN=http://localhost:3000
SETTINGS_PAGE_PASSWORD=

# Резервный курс RUB за 1 USD для `/leverage-calculator`, если `GET /api/fx/rub-usd` не отвечает (клиентский бандл).
# NEXT_PUBLIC_LEVERAGE_RUB_PER_USD=95.5

# --- Bybit ---
BYBIT_TESTNET=true
BYBIT_API_KEY_TESTNET=
BYBIT_API_SECRET_TESTNET=
BYBIT_API_KEY_MAINNET=
BYBIT_API_SECRET_MAINNET=
# Опционально: отдельная пара API-ключей только для глобального private WebSocket (чтение order/position); иначе — ключи дефолтного кабинета из UI, иначе env/глобальные торговые ключи выше. Сеть задаётся BYBIT_TESTNET.
# BYBIT_PRIVATE_WS_API_KEY=
# BYBIT_PRIVATE_WS_API_SECRET=
# Опционально: лимит REST Bybit на кабинет (мс между **каждым** HTTP-запросом), backoff при rate limit, политика private WS при >1 кабинете (auto|force).
# BYBIT_ACCOUNT_REQUEST_INTERVAL_MS=80
# BYBIT_ACCOUNT_MAX_CONCURRENCY зарезервировано (>1 игнорируется; фактически один REST-канал на кабинет).
# BYBIT_ACCOUNT_MAX_CONCURRENCY=1
# BYBIT_RATE_LIMIT_BACKOFF_MS=2000
# BYBIT_WS_MULTI_CABINET=auto
# Интервал фонового опроса Bybit (ордера/позиции), мс. Глобальная настройка в БД (`Setting`); дефолт в коде 2000. 0 — выключить (ломает сопровождение сделок).
# POLLING_INTERVAL_MS=2000
# Фоновое auto-heal «зависших» сделок (sync entry + TP/SL). Очередь execution, не мешает poll/reconcile.
# STUCK_TRADES_AUTO_HEAL_ENABLED=true
# STUCK_TRADES_AUTO_HEAL_INTERVAL_MS=180000
# STUCK_TRADES_AUTO_HEAL_MAX_PER_RUN=2
# STUCK_TRADES_AUTO_HEAL_COOLDOWN_MS=600000
# STUCK_TRADES_AUTO_HEAL_DEFER_BACKOFF_MS=120000

# Пороговые уведомления о equity (totalUsd) по кабинетам → CRITICAL_NOTIFY_URL (см. `postCriticalNotifyText`). false — не регистрировать cron.
# BALANCE_ALERT_ENABLED=true
# Cron в секундах/минутах сервера (как у Nest `@Cron`), по умолчанию раз в 5 минут.
# BALANCE_ALERT_CRON=0 */5 * * * *

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEFAULT=

# --- Telegram bot/userbot ---
TELEGRAM_BOT_TOKEN=
# Таймаут `deleteWebhook` (мс), отдельно от long poll. Диапазон 5000–120000, по умолчанию 30000.
# TELEGRAM_BOT_DELETE_WEBHOOK_TIMEOUT_MS=30000
# Таймаут `getMe` перед стартом long polling (мс), проверка токена; не обрывает сам `getUpdates`. На медленной сети/Railway часто 120000–180000.
# TELEGRAM_BOT_LAUNCH_TIMEOUT_MS=60000
# Пауза между последовательными `deleteWebhook` разных токенов (мс), одна короткая очередь на процесс API. 0 — без паузы; по умолчанию 2000.
# TELEGRAM_BOT_LAUNCH_STAGGER_MS=2000
TELEGRAM_WHITELIST=
# Уведомление в бот при размещении второй стороны по паре в hedge (лонг+шорт): false/0/off — не слать
TELEGRAM_NOTIFY_HEDGE_OPPOSITE_PLACEMENT=
TELEGRAM_STARTUP_MESSAGE=
# Ежедневный дайджест в бот (TELEGRAM_WHITELIST кабинета): false — не слать. Cron в часах сервера (UTC на Railway), по умолчанию 09:00.
# TELEGRAM_DAILY_DIGEST_ENABLED=true
# TELEGRAM_DAILY_DIGEST_CRON=0 0 9 * * *
TELEGRAM_USERBOT_API_ID=
TELEGRAM_USERBOT_API_HASH=
TELEGRAM_USERBOT_SESSION=
# После рестарта API автоматически поднимает MTProto из TELEGRAM_USERBOT_SESSION (если TELEGRAM_USERBOT_ENABLED=true и у кабинета есть owner). Отключить автоподъём: TELEGRAM_USERBOT_SKIP_STARTUP_RESTORE=true
# Пока userbot включён и есть сохранённая сессия, но MTProto не подключён в процессе — каждую минуту POST на CRITICAL_NOTIFY_URL. Отключить: TELEGRAM_USERBOT_DISCONNECTED_CRITICAL_CRON=false
# После 406 AUTH_KEY_DUPLICATED (две реплики с одной сессией): пауза перед повторным connect, мс, по умолчанию 900000 (15 мин), мин 60000, макс 3600000.
# TELEGRAM_USERBOT_AUTH_KEY_DUPLICATE_BACKOFF_MS=900000
# Период записи актуальной строки сессии GramJS в БД (мс), минимум 60000; по умолчанию 600000. Уменьшает шанс «сессия недействительна» после редеплоя при одной реплике API.
# TELEGRAM_USERBOT_SESSION_PERSIST_INTERVAL_MS=600000
# Result без входа: уведомление и автоотмена «висящих» entry-ордеров (с цитатой или по токену в тексте без цитаты).
# TELEGRAM_USERBOT_NOTIFY_RESULT_WITHOUT_ENTRY=true
# TELEGRAM_USERBOT_CANCEL_STALE_ORDERS_ON_RESULT_WITHOUT_ENTRY=false
# Автогенерация контента для information cabinets (редактор /content-editor)
# CONTENT_GENERATION_ENABLED=true
# CONTENT_GENERATION_CRON=0 */1 * * *
# Важно: несколько реплик API с одной MTProto-сессией могут инвалидировать вход — для userbot держите 1 реплику сервиса API или отключайте userbot на лишних инстансах.
