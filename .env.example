# SignalsBot baseline environment example.
# Copy to `.env` (repo root) and/or `apps/api/.env`, then fill real secrets.

# --- Core API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
API_SWAGGER_SERVER=/
API_ACCESS_TOKEN=change-me-very-strong-token
AUTH_JWT_SECRET=change-me-even-stronger-secret
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_ALLOW_PUBLIC_REGISTER=false
AUTH_ADMIN_USER_IDS=

# --- Database ---
DATABASE_URL=postgresql://signals:signals@localhost:5432/signals?schema=public
POSTGRES_USER=signals
POSTGRES_PASSWORD=signals
POSTGRES_DB=signals

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_BASE_PATH=
NEXT_BASE_PATH=
WEB_APP_ORIGIN=http://localhost:3000
SETTINGS_PAGE_PASSWORD=

# --- Bybit ---
BYBIT_TESTNET=true
BYBIT_API_KEY_TESTNET=
BYBIT_API_SECRET_TESTNET=
BYBIT_API_KEY_MAINNET=
BYBIT_API_SECRET_MAINNET=
# Опционально: лимит REST Bybit на кабинет (мс между **каждым** HTTP-запросом), backoff при rate limit, политика private WS при >1 кабинете (auto|force).
# BYBIT_ACCOUNT_REQUEST_INTERVAL_MS=80
# BYBIT_ACCOUNT_MAX_CONCURRENCY зарезервировано (>1 игнорируется; фактически один REST-канал на кабинет).
# BYBIT_ACCOUNT_MAX_CONCURRENCY=1
# BYBIT_RATE_LIMIT_BACKOFF_MS=2000
# BYBIT_WS_MULTI_CABINET=auto
# Интервал фонового опроса Bybit (ордера/позиции), мс. Глобальная настройка в БД (`Setting`); дефолт в коде 2000. 0 — выключить (ломает сопровождение сделок).
# POLLING_INTERVAL_MS=2000

# Пороговые уведомления о equity (totalUsd) по кабинетам → CRITICAL_NOTIFY_URL (см. `postCriticalNotifyText`). false — не регистрировать cron.
# BALANCE_ALERT_ENABLED=true
# Cron в секундах/минутах сервера (как у Nest `@Cron`), по умолчанию раз в 5 минут.
# BALANCE_ALERT_CRON=0 */5 * * * *

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEFAULT=

# --- Telegram bot/userbot ---
TELEGRAM_BOT_TOKEN=
# Таймаут deleteWebhook + launch() для Telegraf на кабинет (мс). На медленной сети/Railway можно поднять до 60000–90000.
# TELEGRAM_BOT_LAUNCH_TIMEOUT_MS=60000
TELEGRAM_WHITELIST=
# Уведомление в бот при размещении второй стороны по паре в hedge (лонг+шорт): false/0/off — не слать
TELEGRAM_NOTIFY_HEDGE_OPPOSITE_PLACEMENT=
TELEGRAM_STARTUP_MESSAGE=
# Ежедневный дайджест в бот (TELEGRAM_WHITELIST кабинета): false — не слать. Cron в часах сервера (UTC на Railway), по умолчанию 09:00.
# TELEGRAM_DAILY_DIGEST_ENABLED=true
# TELEGRAM_DAILY_DIGEST_CRON=0 0 9 * * *
TELEGRAM_USERBOT_API_ID=
TELEGRAM_USERBOT_API_HASH=
TELEGRAM_USERBOT_SESSION=
# После рестарта API автоматически поднимает MTProto из TELEGRAM_USERBOT_SESSION (если TELEGRAM_USERBOT_ENABLED=true и у кабинета есть owner). Отключить автоподъём: TELEGRAM_USERBOT_SKIP_STARTUP_RESTORE=true
# Период записи актуальной строки сессии GramJS в БД (мс), минимум 60000; по умолчанию 600000. Уменьшает шанс «сессия недействительна» после редеплоя при одной реплике API.
# TELEGRAM_USERBOT_SESSION_PERSIST_INTERVAL_MS=600000
# Важно: несколько реплик API с одной MTProto-сессией могут инвалидировать вход — для userbot держите 1 реплику сервиса API или отключайте userbot на лишних инстансах.
